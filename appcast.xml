    <item>
      <title>Airlive Bridge 1.4.2</title>
      <pubDate>Tue, 06 Oct 2026 09:00:00 +0000</pubDate>
      <sparkle:version>20</sparkle:version>
      <sparkle:shortVersionString>1.4.2</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Smoother motion through the virtual camera and every program output: with a camera delay set, frames could leave a few milliseconds early or late, so apps reading the virtual camera sometimes showed the same frame twice. Frames now leave exactly on time.]]></description>
      <enclosure
        url="https://github.com/airlive-project/airlive-bridge/releases/download/v1.4.2/Airlive-Bridge-1.4.2.dmg"
