<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Matches what every shipping camera extension does (compare OBS's, which is
    sandboxed with a team-prefixed group).  A camera extension needs nothing else.
  -->
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <!--
    The App Group id MUST start with the Team ID.  A "TeamID.name" group is
    SELF-AUTHORIZING outside the App Store — the prefix proves ownership, so no
    capability has to be registered on the portal.  The "group.name" form is the
    App Store shape and REQUIRES registration; claiming it unregistered made macOS
    reject this extension outright (the signature asked for an entitlement the
    provisioning profile never granted), and made the app prompt "would like to
    access data from other apps" on every single launch.
  -->
  <key>com.apple.security.application-groups</key>
  <array>
    <string>XWBJP49FTR.studio.airlive.bridge</string>
  </array>
</dict>
</plist>
